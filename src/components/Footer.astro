---
import { t } from '../i18n/translations';
import { type Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
---

<footer class="mt-20 pb-12">
  <!-- Divider with ember accent -->
  <div class="max-w-[900px] mx-auto px-6">
    <div class="rule-ember mb-10"></div>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <!-- Social links -->
      <div class="flex items-center gap-6">
        <a
          class="text-xs font-mono tracking-widest uppercase text-cream-3 hover:text-ember transition-colors duration-200"
          href="https://www.xiaohongshu.com/user/profile/5e1912af0000000001006945"
          target="_blank"
          rel="noopener noreferrer"
        >
          小红书
        </a>
        <a
          class="text-xs font-mono tracking-widest uppercase text-cream-3 hover:text-ember transition-colors duration-200"
          href="https://github.com/capykyo"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('footer.social.github', locale)}
        </a>
        <a
          class="text-xs font-mono tracking-widest uppercase text-cream-3 hover:text-ember transition-colors duration-200"
          href="mailto:kyo@capyexports.com"
        >
          {t('footer.social.email', locale)}
        </a>
      </div>

      <!-- Copyright -->
      <p class="text-xs font-mono text-ink-5 tracking-wide">
        {t('footer.copyright', locale)}
      </p>
    </div>
  </div>
</footer>
