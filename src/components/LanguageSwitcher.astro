---
import { locales, getLocaleDisplayName, getLocalizedPath, type Locale } from '../i18n/utils';
import { getUrl } from '../utils';

interface Props {
  currentLocale: Locale;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathWithoutBase = currentPath.replace(new RegExp(`^${base}\/?`), '').replace(/^\/+/, '');
const segments = pathWithoutBase.split('/').filter(Boolean);
const pathWithoutLocale = segments[0] && ['zh', 'en', 'ja'].includes(segments[0])
  ? segments.slice(1).join('/')
  : pathWithoutBase;
---

<div class="relative group">
  <button
    class="flex items-center gap-1 px-3 py-1.5 text-xs tracking-widest uppercase font-mono text-cream-3 hover:text-cream transition-colors duration-200 rounded hover:bg-ink-4"
    id="language-switcher-button"
    aria-label="Switch language"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <span>{getLocaleDisplayName(currentLocale)}</span>
    <svg class="w-3 h-3 ml-0.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown -->
  <div
    class="absolute right-0 top-full mt-1 w-28 bg-ink-3 border border-ink-5 rounded shadow-xl shadow-black/40 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 overflow-hidden"
    role="menu"
    aria-labelledby="language-switcher-button"
  >
    {locales.map((locale) => {
      const localizedPath = getLocalizedPath(pathWithoutLocale, locale);
      const isActive = locale === currentLocale;

      return (
        <a
          href={getUrl(localizedPath)}
          class={`flex items-center gap-2 px-4 py-2.5 text-xs font-mono tracking-wide transition-colors duration-100 ${
            isActive
              ? 'text-cream bg-ink-4 border-l-2 border-ember'
              : 'text-cream-3 hover:text-cream hover:bg-ink-4 border-l-2 border-transparent'
          }`}
          role="menuitem"
        >
          {isActive && <span class="w-1 h-1 rounded-full bg-ember flex-shrink-0"></span>}
          {!isActive && <span class="w-1 h-1 flex-shrink-0"></span>}
          {getLocaleDisplayName(locale)}
        </a>
      );
    })}
  </div>
</div>

<style>
  @media (hover: none) {
    .group:active .group-hover\:opacity-100 {
      opacity: 1;
      visibility: visible;
    }
  }
</style>
