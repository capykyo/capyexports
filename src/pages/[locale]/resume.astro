---
import { ViewTransitions } from 'astro:transitions';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, getEntry } from 'astro:content';
import { locales, type Locale } from '../../i18n/utils';
import { t } from '../../i18n/translations';
import { getUrl } from '../../utils';
import '../../styles/global.css';
import { marked } from 'marked';

marked.setOptions({ breaks: true, gfm: true });

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const allResumes = await getCollection('resume');
const resumeMatch = allResumes.find((r) => r.data.lang === locale);

if (!resumeMatch) {
  return Astro.redirect(`/${locale}/`);
}

let Content: any = null;
let renderedHtml: string | null = null;
let resumeEntry = resumeMatch;

try {
  const entry = await getEntry('resume', resumeMatch.id);
  if (entry) {
    resumeEntry = entry;
    if ('render' in entry && typeof entry.render === 'function') {
      const rendered = await entry.render();
      Content = rendered.Content;
    } else if (entry.body) {
      renderedHtml = marked(entry.body) as string;
    }
  }
} catch (e) {
  resumeEntry = resumeMatch;
  if (resumeMatch.body) renderedHtml = marked(resumeMatch.body) as string;
}

const pageTitle = `${resumeEntry.data.title} - ${t('meta.title', locale as Locale)}`;
---

<!doctype html>
<html lang={locale as string}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={getUrl("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={resumeEntry.data.title} />
    <title>{pageTitle}</title>
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Sora:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-ink">
    <Header locale={locale as Locale} />

    <main class="max-w-[900px] mx-auto px-6 pt-24 md:pt-28 pb-24">

      <!-- Back -->
      <div class="mb-10">
        <a
          href={getUrl(`/${locale}/`)}
          class="inline-flex items-center gap-2 text-xs font-mono tracking-widest uppercase text-cream-3 hover:text-ember transition-colors duration-200 group"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="group-hover:-translate-x-0.5 transition-transform duration-200">
            <path d="M12 7H2M6 3L2 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {t('works.back', locale as Locale)}
        </a>
      </div>

      <!-- Resume header -->
      <header class="mb-12">
        <!-- Label -->
        <div class="mb-3">
          <span class="section-label">{resumeEntry.data.title}</span>
        </div>

        <!-- Name -->
        <h1 class="font-serif text-5xl md:text-6xl text-cream leading-tight mb-6">
          {resumeEntry.data.name}
        </h1>

        <!-- Divider -->
        <div class="rule-ember mb-8"></div>

        <!-- Contact info grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          {resumeEntry.data.email && (
            <a
              href={`mailto:${resumeEntry.data.email}`}
              class="flex items-center gap-3 text-sm text-cream-3 hover:text-cream transition-colors duration-200 group"
            >
              <svg class="w-4 h-4 shrink-0 text-ember/60 group-hover:text-ember transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
              {resumeEntry.data.email}
            </a>
          )}
          {resumeEntry.data.phone && (
            <div class="flex items-center gap-3 text-sm text-cream-3">
              <svg class="w-4 h-4 shrink-0 text-ember/60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              {resumeEntry.data.phone}
            </div>
          )}
          {resumeEntry.data.location && (
            <div class="flex items-center gap-3 text-sm text-cream-3">
              <svg class="w-4 h-4 shrink-0 text-ember/60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
              {resumeEntry.data.location}
            </div>
          )}
          {resumeEntry.data.website && (
            <a
              href={resumeEntry.data.website}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-sm text-cream-3 hover:text-cream transition-colors duration-200 group"
            >
              <svg class="w-4 h-4 shrink-0 text-ember/60 group-hover:text-ember transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
              {resumeEntry.data.website.replace(/^https?:\/\//, '')}
            </a>
          )}
        </div>

        <!-- Social links -->
        <div class="flex flex-wrap gap-3">
          {resumeEntry.data.github && (
            <a
              href={resumeEntry.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="tag-pill hover:border-ember hover:text-cream"
            >
              <svg class="w-3 h-3 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          )}
          {resumeEntry.data.linkedin && (
            <a
              href={resumeEntry.data.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="tag-pill hover:border-ember hover:text-cream"
            >
              <svg class="w-3 h-3 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          )}
          {resumeEntry.data.xiaohongshu && (
            <a
              href={resumeEntry.data.xiaohongshu}
              target="_blank"
              rel="noopener noreferrer"
              class="tag-pill hover:border-ember hover:text-cream"
            >
              小红书
            </a>
          )}
        </div>
      </header>

      <!-- Resume content -->
      {Content ? (
        <article class="prose prose-ink prose-sm md:prose-base max-w-none
          prose-headings:font-serif prose-headings:font-normal prose-headings:tracking-tight
          prose-h2:text-2xl prose-h2:border-b prose-h2:border-ink-5 prose-h2:pb-2 prose-h2:mb-4
          prose-h3:text-lg prose-h3:text-ember-2
          prose-a:text-ember-2 prose-a:no-underline hover:prose-a:underline
          prose-code:bg-ink-3 prose-code:px-1 prose-code:rounded prose-code:text-xs
          prose-pre:bg-ink-3 prose-pre:border prose-pre:border-ink-5
          prose-blockquote:border-l-ember prose-blockquote:text-cream-3 prose-blockquote:not-italic
          prose-strong:text-cream prose-strong:font-semibold
          prose-li:text-cream-2 prose-p:text-cream-2">
          <Content />
        </article>
      ) : renderedHtml ? (
        <article class="prose prose-ink prose-sm md:prose-base max-w-none
          prose-headings:font-serif prose-headings:font-normal prose-headings:tracking-tight
          prose-h2:text-2xl prose-h2:border-b prose-h2:border-ink-5 prose-h2:pb-2 prose-h2:mb-4
          prose-h3:text-lg prose-h3:text-ember-2
          prose-a:text-ember-2 prose-a:no-underline hover:prose-a:underline
          prose-code:bg-ink-3 prose-code:px-1 prose-code:rounded prose-code:text-xs
          prose-pre:bg-ink-3 prose-pre:border prose-pre:border-ink-5
          prose-blockquote:border-l-ember prose-blockquote:text-cream-3 prose-blockquote:not-italic
          prose-strong:text-cream prose-strong:font-semibold
          prose-li:text-cream-2 prose-p:text-cream-2">
          <div set:html={renderedHtml} />
        </article>
      ) : null}
    </main>

    <Footer locale={locale as Locale} />
  </body>
</html>
